# Django Secret Key (generate a new one for production!)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-change-me-in-production

# Django Debug Mode (set to False in production)
DJANGO_DEBUG=True

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Firebase Admin SDK Service Account JSON Path
# Use absolute path or relative to project root
FCM_SERVICE_ACCOUNT_PATH=/path/to/your/firebase-credentials.json

# Celery Broker (optional, for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
